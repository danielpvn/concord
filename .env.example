# ==========================================
# CONCORD - CONFIGURAÇÃO DE AMBIENTE
# ==========================================

# Porta do Servidor (Render/Nuvem define automaticamente)
PORT=3001

# Chave Secreta para Tokens JWT
JWT_SECRET=concord-secret-key-gaming-friends-2026-troque-em-producao

# URL do Banco de Dados SQLite (ou Supabase/PostgreSQL)
DATABASE_URL=file:./dev.db

# (Opcional) Configurações do LiveKit para SFU Voice em Nuvem
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# (Recomendado) Servidor TURN para voz/tela funcionarem em 4G e redes com NAT restritivo.
# Configure UMA das opcoes abaixo no Render (Environment):
# Cloudflare Realtime TURN (gratis ate 1000 GB/mes)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Metered.ca (gratis 50 GB/mes)
METERED_DOMAIN=
METERED_API_KEY=
# TURN proprio (urls separadas por virgula)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
